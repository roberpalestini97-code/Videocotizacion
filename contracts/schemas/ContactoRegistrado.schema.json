{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContactoRegistrado",
  "description": "Confirmación del contacto: no repite los datos personales.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sesion_id",
    "registrado_en",
    "aviso_version",
    "retencion_dias"
  ],
  "properties": {
    "sesion_id": {
      "$ref": "IdSesion.schema.json"
    },
    "registrado_en": {
      "$ref": "FechaHora.schema.json"
    },
    "aviso_version": {
      "$ref": "VersionAviso.schema.json"
    },
    "retencion_dias": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    }
  },
  "examples": [
    {
      "sesion_id": "ses_FFPS51S06FXAT3HXHKKKAS7A38",
      "registrado_en": "2026-10-08T13:16:00Z",
      "aviso_version": "2026-10-08.1",
      "retencion_dias": 90
    }
  ]
}
