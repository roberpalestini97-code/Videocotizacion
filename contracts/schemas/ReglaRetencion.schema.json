{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReglaRetencion",
  "description": "Regla de retención por tipo de dato (R21, R43). plazo_dias 0 y persistido false = nunca se guarda. plazo_dias es el valor POR DEFECTO de la plataforma; si configurable, el operador lo fija por tenant con la CLI (`api tenant configurar`, C6) dentro de [plazo_dias_min, plazo_dias_max]. Los contadores de consumo (solo agregados) no figuran: no tienen datos personales.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tipo_dato",
    "finalidad",
    "persistido",
    "plazo_dias",
    "configurable"
  ],
  "properties": {
    "tipo_dato": {
      "type": "string",
      "enum": [
        "consulta_y_presupuesto",
        "contacto_cliente",
        "registro_lecturas",
        "consentimientos",
        "solicitudes_arco",
        "fotogramas",
        "audio",
        "transcripcion_completa",
        "perfil_asesor"
      ]
    },
    "finalidad": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^<>\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*$"
    },
    "persistido": {
      "type": "boolean"
    },
    "plazo_dias": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3650
    },
    "configurable": {
      "type": "boolean"
    },
    "plazo_dias_min": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "plazo_dias_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    }
  },
  "if": {
    "type": "object",
    "properties": {
      "configurable": {
        "const": true
      }
    },
    "required": [
      "configurable"
    ]
  },
  "then": {
    "type": "object",
    "properties": {
      "plazo_dias_min": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3650
      },
      "plazo_dias_max": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3650
      }
    },
    "required": [
      "plazo_dias_min",
      "plazo_dias_max"
    ]
  },
  "else": {
    "type": "object",
    "properties": {
      "plazo_dias_min": false,
      "plazo_dias_max": false
    }
  },
  "examples": [
    {
      "tipo_dato": "fotogramas",
      "finalidad": "Extraer datos del trabajo en memoria",
      "persistido": false,
      "plazo_dias": 0,
      "configurable": false
    }
  ]
}
