{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cotizacion",
  "description": "Presupuesto orientativo emitido al final (BRIEF 5) como RANGO (B1): total_min_centavos = suma de importe_min_centavos, total_max_centavos = suma de importe_max_centavos, min ≤ max. precio_final_centavos es opcional y solo existe si el tarifario está validado y el rango es un punto (total_min = total_max = precio_final); con tarifas sin validar NUNCA va. zona \"otra\" ⇒ fuera_de_zona true y se emite igual (T24).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cotizacion_id",
    "sesion_id",
    "emitida_en",
    "moneda",
    "oficio",
    "zona",
    "fuera_de_zona",
    "items",
    "total_min_centavos",
    "total_max_centavos",
    "orientativa",
    "leyenda",
    "tarifas",
    "validez_dias"
  ],
  "properties": {
    "cotizacion_id": {
      "$ref": "IdCotizacion.schema.json"
    },
    "sesion_id": {
      "$ref": "IdSesion.schema.json"
    },
    "emitida_en": {
      "$ref": "FechaHora.schema.json"
    },
    "moneda": {
      "$ref": "Moneda.schema.json"
    },
    "oficio": {
      "$ref": "Oficio.schema.json"
    },
    "zona": {
      "$ref": "Zona.schema.json"
    },
    "fuera_de_zona": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "ItemCotizacion.schema.json"
      },
      "minItems": 1,
      "maxItems": 30
    },
    "total_min_centavos": {
      "$ref": "Centavos.schema.json"
    },
    "total_max_centavos": {
      "$ref": "Centavos.schema.json"
    },
    "precio_final_centavos": {
      "$ref": "Centavos.schema.json"
    },
    "orientativa": {
      "type": "boolean",
      "const": true
    },
    "leyenda": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[^<>\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*$"
    },
    "tarifas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "estado"
      ],
      "properties": {
        "version": {
          "$ref": "VersionTarifas.schema.json"
        },
        "estado": {
          "type": "string",
          "enum": [
            "referencia_publica_sin_validar",
            "validada"
          ]
        }
      }
    },
    "validez_dias": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "zona": {
            "const": "otra"
          }
        },
        "required": [
          "zona"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "fuera_de_zona": {
            "const": true
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "fuera_de_zona": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "tarifas": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": true,
              "estado": {
                "const": "referencia_publica_sin_validar"
              }
            },
            "required": [
              "estado"
            ]
          }
        },
        "required": [
          "tarifas"
        ]
      },
      "then": {
        "type": "object",
        "not": {
          "type": "object",
          "properties": {
            "precio_final_centavos": {
              "$ref": "Centavos.schema.json"
            }
          },
          "required": [
            "precio_final_centavos"
          ]
        }
      }
    }
  ],
  "examples": [
