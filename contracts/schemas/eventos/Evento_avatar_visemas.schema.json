                  "SS",
                  "nn",
                  "RR",
                  "aa",
                  "E",
                  "I",
                  "O",
                  "U"
                ]
              },
              "t_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 600000
              },
              "d_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5000
              }
            }
          },
          "minItems": 1,
          "maxItems": 2000
        }
      }
    }
  },
  "examples": [
    {
      "v": 1,
