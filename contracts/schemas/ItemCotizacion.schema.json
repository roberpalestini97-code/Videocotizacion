{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemCotizacion",
  "description": "Ítem del presupuesto con RANGO (B1): el tarifario solo tiene rangos mínimo–máximo. importe_X_centavos = (cantidad_centesimas × precio_unitario_X_centavos + 50) div 100 para X = min y max (redondeo mitad hacia arriba, enteros) y min ≤ max. Calculado por Go desde tarifas, nunca por el LLM.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tipo",
    "codigo_tarea",
    "descripcion",
    "unidad",
    "cantidad_centesimas",
    "precio_unitario_min_centavos",
    "precio_unitario_max_centavos",
    "importe_min_centavos",
    "importe_max_centavos"
  ],
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "mano_de_obra",
        "traslado",
        "recargo"
      ]
    },
    "codigo_tarea": {
      "type": "string",
      "pattern": "^[a-z0-9_]{3,60}$"
    },
    "descripcion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^<>\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*$"
    },
    "unidad": {
      "$ref": "UnidadMedida.schema.json"
    },
    "cantidad_centesimas": {
      "$ref": "CantidadCentesimas.schema.json"
    },
    "precio_unitario_min_centavos": {
      "$ref": "Centavos.schema.json"
    },
    "precio_unitario_max_centavos": {
      "$ref": "Centavos.schema.json"
    },
    "importe_min_centavos": {
      "$ref": "Centavos.schema.json"
    },
    "importe_max_centavos": {
      "$ref": "Centavos.schema.json"
    }
  },
  "examples": [
    {
      "tipo": "mano_de_obra",
      "codigo_tarea": "pintura_interior",
      "descripcion": "Pintura interior látex, dos manos",
      "unidad": "m2",
      "cantidad_centesimas": 1250,
      "precio_unitario_min_centavos": 185000,
      "precio_unitario_max_centavos": 259000,
      "importe_min_centavos": 2312500,
      "importe_max_centavos": 3237500
    }
  ]
}
