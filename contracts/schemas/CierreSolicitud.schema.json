{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CierreSolicitud",
  "description": "Cierre pedido por el cliente o el tenant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "motivo"
  ],
  "properties": {
    "motivo": {
      "type": "string",
      "enum": [
        "cliente_cerro",
        "sin_consentimiento",
        "sin_camara"
      ]
    }
  },
  "examples": [
    {
      "motivo": "cliente_cerro"
    }
  ]
}
