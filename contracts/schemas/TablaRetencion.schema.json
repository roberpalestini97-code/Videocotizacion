{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TablaRetencion",
  "description": "Tabla de retención vigente (R21). Plazos propuestos, a validar con abogado.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "a_validar_con_abogado",
    "reglas"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]{1,3}$"
    },
    "a_validar_con_abogado": {
      "type": "boolean",
      "const": true
    },
    "reglas": {
      "type": "array",
      "items": {
        "$ref": "ReglaRetencion.schema.json"
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "examples": [
    {
      "version": "2026-10-08.1",
      "a_validar_con_abogado": true,
      "reglas": [
        {
          "tipo_dato": "consulta_y_presupuesto",
          "finalidad": "Backoffice y seguimiento del presupuesto",
          "persistido": true,
          "plazo_dias": 365,
          "configurable": true
        },
        {
          "tipo_dato": "contacto_cliente",
          "finalidad": "Que el profesional te contacte",
          "persistido": true,
          "plazo_dias": 90,
          "configurable": true
        },
        {
          "tipo_dato": "registro_lecturas",
          "finalidad": "Trazabilidad de accesos",
          "persistido": true,
          "plazo_dias": 730,
          "configurable": true
        },
        {
          "tipo_dato": "consentimientos",
          "finalidad": "Prueba del consentimiento",
          "persistido": true,
          "plazo_dias": 730,
          "configurable": true
        },
        {
          "tipo_dato": "solicitudes_arco",
          "finalidad": "Constancia de derechos ARCO (anonimizada)",
          "persistido": true,
          "plazo_dias": 730,
          "configurable": true
        },
        {
          "tipo_dato": "perfil_asesor",
          "finalidad": "Operar el panel",
          "persistido": true,
          "plazo_dias": 365,
          "configurable": true
        },
        {
          "tipo_dato": "fotogramas",
          "finalidad": "Extraer datos del trabajo en memoria",
          "persistido": false,
          "plazo_dias": 0,
          "configurable": false
        },
        {
          "tipo_dato": "audio",
          "finalidad": "Transcripción en memoria",
          "persistido": false,
          "plazo_dias": 0,
          "configurable": false
        },
        {
          "tipo_dato": "transcripcion_completa",
          "finalidad": "No se guarda (ADR 0004)",
          "persistido": false,
          "plazo_dias": 0,
          "configurable": false
        }
      ]
    }
  ]
}
