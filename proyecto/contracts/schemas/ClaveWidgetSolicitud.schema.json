{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaveWidgetSolicitud",
  "description": "Alta de clave pública con su lista de Origin exactos (R54, R55).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nombre",
    "origins"
  ],
  "properties": {
    "nombre": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[^<>\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*$"
    },
    "origins": {
      "type": "array",
      "items": {
        "$ref": "Origin.schema.json"
      },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    }
  },
  "examples": [
    {
      "nombre": "Landing jardinería",
      "origins": [
        "https://cotizar.videocotizacion.local",
        "https://socio.ejemplo.local:8443"
      ]
    }
  ]
}
