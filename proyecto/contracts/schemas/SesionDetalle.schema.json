{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SesionDetalle",
  "description": "Detalle de una consulta para el asesor. SIN código de referencia, SIN derivación y SIN contacto_disponible (T39). Leerlo deja fila en el registro de lecturas (R69).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sesion_id",
    "estado",
    "modo_avatar",
    "creada_en",
    "duracion_s",
    "resumen",
    "versiones"
  ],
  "properties": {
    "sesion_id": {
      "$ref": "IdSesion.schema.json"
    },
    "estado": {
      "$ref": "EstadoSesion.schema.json"
    },
    "modo_avatar": {
      "$ref": "ModoAvatar.schema.json"
    },
    "creada_en": {
      "$ref": "FechaHora.schema.json"
    },
    "cerrada_en": {
      "$ref": "FechaHora.schema.json"
    },
    "motivo_cierre": {
      "$ref": "MotivoCierre.schema.json"
    },
    "duracion_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "datos_extraidos": {
      "$ref": "DatosExtraidos.schema.json"
    },
    "cotizacion": {
      "$ref": "Cotizacion.schema.json"
    },
    "resumen": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^<>\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*$"
    },
    "versiones": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tarifas",
        "prompt",
        "esquema_salida"
      ],
      "properties": {
        "tarifas": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{1,3}$"
        },
        "prompt": {
          "type": "string",
          "pattern": "^[a-z0-9_]+@[0-9a-f]{12}$"
        },
        "esquema_salida": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.]+)?$"
        }
      }
    },
    "respuestas_modelo": {
      "type": "array",
      "items": {
        "$ref": "RespuestaModelo.schema.json"
      },
      "minItems": 0,
      "maxItems": 200
    }
  },
