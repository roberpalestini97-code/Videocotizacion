{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evento_sesion_cerrada",
  "description": "NO CONGELADO (borrador vc-eventos.borrador.1). Servidor → cliente: cierre con motivo (R60).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "tipo",
    "seq",
    "ts",
    "datos"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "tipo": {
      "type": "string",
      "const": "sesion.cerrada"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "ts": {
      "$ref": "../FechaHora.schema.json"
    },
    "datos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motivo_cierre",
        "duracion_s"
      ],
      "properties": {
        "motivo_cierre": {
          "$ref": "../MotivoCierre.schema.json"
        },
        "duracion_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    }
  },
  "examples": [
    {
      "v": 1,
      "tipo": "sesion.cerrada",
      "seq": 9,
      "ts": "2026-10-08T13:01:00Z",
      "datos": {
        "motivo_cierre": "completada",
        "duracion_s": 600
      }
    },
    {
      "v": 1,
      "tipo": "sesion.cerrada",
      "seq": 10,
      "ts": "2026-10-08T13:01:00Z",
      "datos": {
        "motivo_cierre": "cliente_cerro",
        "duracion_s": 601
      }
    }
  ]
}
