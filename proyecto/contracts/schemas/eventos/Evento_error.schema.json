{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evento_error",
  "description": "NO CONGELADO (borrador vc-eventos.borrador.1). Servidor → cliente: error recuperable o previo al cierre.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "tipo",
    "seq",
    "ts",
    "datos"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "tipo": {
      "type": "string",
      "const": "error"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "ts": {
      "$ref": "../FechaHora.schema.json"
    },
    "datos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codigo",
        "mensaje"
      ],
      "properties": {
        "codigo": {
          "$ref": "../CodigoError.schema.json"
        },
        "mensaje": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[^<>\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*$"
        }
      }
    }
  },
  "examples": [
    {
      "v": 1,
      "tipo": "error",
      "seq": 9,
      "ts": "2026-10-08T13:01:00Z",
      "datos": {
        "codigo": "proveedor_no_disponible",
        "mensaje": "Tuvimos un problema; seguimos en un momento."
      }
    },
    {
      "v": 1,
      "tipo": "error",
      "seq": 10,
      "ts": "2026-10-08T13:01:00Z",
      "datos": {
        "codigo": "limite_de_tasa",
        "mensaje": "Tuvimos un problema; seguimos en un momento."
      }
    }
  ]
}
