{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evento_sesion_lista",
  "description": "NO CONGELADO (borrador vc-eventos.borrador.1). Servidor → cliente: token aceptado; arranca la conversación.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "tipo",
    "seq",
    "ts",
    "datos"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "tipo": {
      "type": "string",
      "const": "sesion.lista"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "ts": {
      "$ref": "../FechaHora.schema.json"
    },
    "datos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sesion_id",
        "limites"
      ],
      "properties": {
        "sesion_id": {
          "$ref": "../IdSesion.schema.json"
        },
        "limites": {
          "$ref": "../LimitesSesion.schema.json"
        },
        "stt": {
          "type": "string",
          "enum": [
            "navegador",
            "servidor"
          ],
          "description": "Quién transcribe la voz: navegador (el cliente manda texto.enviar) o servidor (el cliente manda tramas 0x01 PCM16). Ausente = navegador."
        }
      }
    }
  },
  "examples": [
    {
      "v": 1,
      "tipo": "sesion.lista",
      "seq": 0,
      "ts": "2026-10-08T13:01:00Z",
      "datos": {
        "sesion_id": "ses_FFPS51S06FXAT3HXHKKKAS7A38",
        "limites": {
          "sin_voz_s": 20,
          "duracion_maxima_s": 900,
          "caracteres_max_por_turno": 500,
          "turnos_llm_max": 60,
          "fotograma": {
            "formato": "image/jpeg",
            "lado_max_px": 1024,
            "bytes_max": 131072,
            "intervalo_min_ms": 3000,
            "max_por_sesion": 400
          }
        }
      }
    },
    {
      "v": 1,
      "tipo": "sesion.lista",
      "seq": 0,
      "ts": "2026-10-08T13:01:00Z",
      "datos": {
        "sesion_id": "ses_SX2NE9K3Z89ZMZHZHV6ZR2J79H",
        "limites": {
          "sin_voz_s": 30,
          "duracion_maxima_s": 1200,
          "caracteres_max_por_turno": 500,
          "turnos_llm_max": 60,
          "fotograma": {
            "formato": "image/jpeg",
            "lado_max_px": 1024,
            "bytes_max": 131072,
            "intervalo_min_ms": 3000,
            "max_por_sesion": 400
          }
        },
        "stt": "servidor"
      }
    }
  ]
}
