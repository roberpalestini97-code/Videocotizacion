{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evento_pizarron_actualizado",
  "description": "NO CONGELADO (borrador vc-eventos.borrador.1). Servidor → cliente: pizarrón en vivo; nunca contiene montos (ADR 0006).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "tipo",
    "seq",
    "ts",
    "datos"
  ],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "tipo": {
      "type": "string",
      "const": "pizarron.actualizado"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "ts": {
      "$ref": "../FechaHora.schema.json"
    },
    "datos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "campos"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "campos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clave",
              "etiqueta",
              "valor",
              "estado"
            ],
            "properties": {
              "clave": {
                "type": "string",
                "pattern": "^[a-z0-9_]{2,60}$"
              },
              "etiqueta": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "^[^<>\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*$"
              },
              "valor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^<>\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]*$"
              },
              "estado": {
                "type": "string",
                "enum": [
                  "anotado",
                  "corregido_por_cliente",
                  "faltante"
                ]
              }
            }
          },
          "minItems": 0,
          "maxItems": 40
        }
      }
    }
  },
  "examples": [
    {
      "v": 1,
      "tipo": "pizarron.actualizado",
      "seq": 5,
      "ts": "2026-10-08T13:01:00Z",
      "datos": {
        "version": 1,
        "campos": [
          {
            "clave": "oficio",
            "etiqueta": "Oficio",
            "valor": "Pintura",
            "estado": "anotado"
          },
          {
            "clave": "superficie_m2",
            "etiqueta": "Superficie",
            "valor": "40 m²",
            "estado": "anotado"
          },
          {
            "clave": "altura",
            "etiqueta": "Altura",
            "valor": "Falta",
            "estado": "faltante"
          }
        ]
      }
    },
    {
      "v": 1,
      "tipo": "pizarron.actualizado",
      "seq": 6,
      "ts": "2026-10-08T13:01:00Z",
      "datos": {
        "version": 2,
        "campos": [
          {
            "clave": "oficio",
            "etiqueta": "Oficio",
            "valor": "Pintura",
            "estado": "anotado"
          },
          {
            "clave": "superficie_m2",
            "etiqueta": "Superficie",
            "valor": "40 m²",
            "estado": "corregido_por_cliente"
          },
          {
            "clave": "altura",
            "etiqueta": "Altura",
            "valor": "Falta",
            "estado": "faltante"
          }
        ]
      }
    }
  ]
}
