{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SesionCreada",
  "description": "Respuesta de crearSesion. NO incluye token de medios: primero consentimiento (R10, O1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sesion_id",
    "estado",
    "token_sesion",
    "consentimiento",
    "limites",
    "creada_en"
  ],
  "properties": {
    "sesion_id": {
      "$ref": "IdSesion.schema.json"
    },
    "estado": {
      "type": "string",
      "const": "creada"
    },
    "token_sesion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valor",
        "vence_en"
      ],
      "properties": {
        "valor": {
          "type": "string",
          "pattern": "^vc_ses_[A-Za-z0-9_-]{43}$"
        },
        "vence_en": {
          "$ref": "FechaHora.schema.json"
        }
      }
    },
    "consentimiento": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requerido",
        "aviso_version",
        "aviso_url"
      ],
      "properties": {
        "requerido": {
          "type": "boolean",
          "const": true
        },
        "aviso_version": {
          "$ref": "VersionAviso.schema.json"
        },
        "aviso_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "limites": {
      "$ref": "LimitesSesion.schema.json"
    },
    "creada_en": {
      "$ref": "FechaHora.schema.json"
    }
  },
  "examples": [
    {
      "sesion_id": "ses_FFPS51S06FXAT3HXHKKKAS7A38",
      "estado": "creada",
      "token_sesion": {
        "valor": "vc_ses_zqH_QeT8gzh36yFkxFok1WZ00X8bLivXDJYsocQursD",
        "vence_en": "2026-10-08T14:00:00Z"
      },
      "consentimiento": {
        "requerido": true,
        "aviso_version": "2026-10-08.1",
        "aviso_url": "https://cotizar.videocotizacion.local/privacidad/2026-10-08.1"
      },
      "limites": {
        "sin_voz_s": 20,
        "duracion_maxima_s": 900,
        "caracteres_max_por_turno": 500,
        "turnos_llm_max": 60,
        "fotograma": {
          "formato": "image/jpeg",
          "lado_max_px": 1024,
          "bytes_max": 131072,
          "intervalo_min_ms": 3000,
          "max_por_sesion": 400
        }
      },
      "creada_en": "2026-10-08T13:00:00Z"
    }
  ]
}
