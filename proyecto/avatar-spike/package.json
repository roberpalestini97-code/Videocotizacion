{
  "name": "vc-avatar-spike",
  "private": true,
  "version": "0.0.0-spike",
  "description": "SPIKE T07 (descartable): avatar 3D con visemas, modo clips, pizarrón y muestreo de cámara para VideoCotización",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
