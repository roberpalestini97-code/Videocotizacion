    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "happy-dom": "20.11.1",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "5.0.1"
  }
}
