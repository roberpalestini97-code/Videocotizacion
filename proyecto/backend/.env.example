# VideoCotización API — desarrollo local (no versionar .env real).
# Copiar a backend/.env y completar. `api servir` carga .env si ENTORNO != produccion.
# Orquestación: proyecto/scripts/levantar-local.ps1
# Semilla demo (enlace demoLocalVideocotiz001): internal/semillalocal/semilla.go

ENTORNO=desarrollo
ALMACEN=memoria
DIRECCION=127.0.0.1:8080

# Mínimo 32 caracteres (hash de claves públicas del widget).
CLAVE_HMAC=clave-de-desarrollo-de-32-bytes-minimo

PROVEEDOR_STT=falso
PROVEEDOR_LLM=falso
PROVEEDOR_TTS=falso
PROVEEDOR_WHATSAPP=falso

# 1 = tenant/enlace/clave pública fijos en memoria (solo desarrollo + ALMACEN=memoria).
SEMILLA_LOCAL=1

LOG_NIVEL=debug

# Opcional: LLM real (requiere clave; no commitear).
# PROVEEDOR_LLM=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# PROVEEDOR_STT=navegador
# PROVEEDOR_TTS=navegador
# PROVEEDOR_WHATSAPP=enlace

# PostgreSQL local (sin SEMILLA_LOCAL o con migraciones):
# ALMACEN=postgres
# DB_URL=postgres://vc_api:...@127.0.0.1:5432/videocotizacion?sslmode=disable
# DB_URL_DUENO=postgres://vc_dueno:...@127.0.0.1:5432/videocotizacion?sslmode=disable
