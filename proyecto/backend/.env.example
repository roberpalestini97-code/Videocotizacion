# VideoCotización API — desarrollo local (no versionar .env real).
# Copiar a backend/.env y completar GEMINI_API_KEY. Guía: ../../ENTORNO.md
# `api servir` carga .env si ENTORNO != produccion.
# Orquestación: proyecto/scripts/levantar-local.ps1
# Semilla demo (enlace demoLocalVideocotiz001): internal/semillalocal/semilla.go

ENTORNO=desarrollo
ALMACEN=memoria
DIRECCION=127.0.0.1:8080

# Frase de desarrollo, igual en todas las máquinas. No es un secreto de producción.
CLAVE_HMAC=clave-de-desarrollo-de-32-bytes-minimo

# Voz en el navegador (Chrome o Edge). El servidor no hace STT ni TTS.
# WhatsApp solo arma un enlace wa.me.
PROVEEDOR_STT=navegador
PROVEEDOR_LLM=gemini
PROVEEDOR_TTS=navegador
PROVEEDOR_WHATSAPP=enlace

# 1 = tenant/enlace/clave pública fijos en memoria (solo desarrollo + ALMACEN=memoria).
SEMILLA_LOCAL=1

LOG_NIVEL=debug

# Obligatoria. No está en el repo: https://aistudio.google.com/apikey
# Con nivel gratuito, solo datos ficticios (proyecto/docs/ia/gemini.md).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL (no hace falta para el entorno de memoria de arriba):
# ALMACEN=postgres
# SEMILLA_LOCAL=0
# DB_URL=postgres://vc_api:...@127.0.0.1:5432/videocotizacion?sslmode=disable
# DB_URL_DUENO=postgres://vc_dueno:...@127.0.0.1:5432/videocotizacion?sslmode=disable
