# VideoCotización · variables del compose (T11). Copiar a ".env" con scripts/generar-secretos.sh.
# Este archivo NO tiene secretos reales: CAMBIAR_GENERAR lo reemplaza el script por 256 bits aleatorios;
# CAMBIAR_PEGAR_* hay que completarlo a mano. El ".env" real nunca se versiona (modo 0600).

# --- Dominio y TLS (pendiente P4 de Rober: dominio propio) ---
# Caddy publica: api.<DOMINIO>, panel.<DOMINIO> y assets.<DOMINIO> (el front de Lovable, cotizar.<DOMINIO>, queda afuera).
DOMINIO=videocotizacion.local
# Correo para Let's Encrypt (obligatorio en producción; con local_certs no se usa).
ACME_EMAIL=ops@videocotizacion.local
# Origin exacto del front de Lovable que puede cargar los archivos del avatar (CORS, sin comodín).
ORIGEN_FRONT=https://cotizar.videocotizacion.local
# Opción global de Caddy, una línea de texto:
#   local_certs                                  -> CA interna de Caddy (pruebas locales; el navegador mostrará aviso)
#   acme_ca https://acme-staging-v02.api.letsencrypt.org/directory   -> staging de Let's Encrypt
#   (vacío)                                      -> producción con Let's Encrypt
CADDY_OPCION_GLOBAL=local_certs

# --- Imagen de la API ---
VC_VERSION=dev

# --- PostgreSQL (tres contraseñas distintas; nunca reutilizar) ---
# Superusuario "postgres": solo para inicializar y administrar a mano; la API y las migraciones no lo usan.
PG_SUPERUSER_PASSWORD=CAMBIAR_GENERAR
# vc_dueno: dueño de las tablas; solo el paso "migrar" lo usa.
VC_DUENO_PASSWORD=CAMBIAR_GENERAR
# vc_api: rol de la API, sin BYPASSRLS.
VC_API_PASSWORD=CAMBIAR_GENERAR
VC_DB_NAME=videocotizacion

# --- API (nombres que lee backend/internal/config: sin prefijo VC_) ---
# Clave interna de hash y firma. El script de secretos rellena CAMBIAR_GENERAR.
VC_CLAVE_HMAC=CAMBIAR_GENERAR
# Proveedores elegidos en T13. STT y TTS los hace el navegador; WhatsApp es un enlace.
PROVEEDOR_STT=navegador
PROVEEDOR_TTS=navegador
PROVEEDOR_LLM=gemini
PROVEEDOR_WHATSAPP=enlace
GEMINI_MODEL=gemini-3.5-flash-lite
# La clave de Gemini no va acá. Crear infra/secrets/gemini_api_key (no se versiona;
# infra/.gitignore ignora secrets/). El compose la monta en GEMINI_API_KEY_FILE.

# --- Límites de recursos (VM chica; ajustar a la VM real) ---
DB_MEM_LIMIT=1g
DB_CPUS=1.0
API_MEM_LIMIT=768m
API_CPUS=1.5
PROXY_MEM_LIMIT=256m
PROXY_CPUS=0.5
